APP_NAME="Professional Papers"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Conexión con google
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret
# Para producción
# GOOGLE_REDIRECT_URI=https://propaps.com/auth/google/callback
# Para local
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=secure_papers_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo
# En local se usa "log": los correos se escriben en storage/logs/laravel.log y no se envían.
# Para probar el envío real por Gmail, cambiar MAIL_MAILER a smtp.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_URL=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@propaps.com
MAIL_PASSWORD=tu_contrasena_de_aplicacion
MAIL_FROM_ADDRESS=tu_correo@propaps.com
MAIL_FROM_NAME="Propaps.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Pasarela de pagos Wompi
# En local NUNCA usar las llaves de producción (cobran dinero real).
# Llaves de pruebas: panel de Wompi > modo Sandbox > Desarrolladores (pub_test_, prv_test_, test_integrity_, test_events_).
WOMPI_ENVIRONMENT=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# true: un pago aprobado en sandbox da acceso real (solo funciona si APP_ENV no es production).
WOMPI_SANDBOX_ACCESS=false

# Activar solo tras verificar SMTP y el trabajador de la cola project-mail.
PROPAPS_PROJECT_EMAIL_ENABLED=false
# PROPAPS_PROJECT_ADMIN_EMAILS=gerencia@propaps.com
# PROPAPS_EMAIL_VERIFICATION_REQUIRED=false
